{
  "name": "calendar-simple",
  "version": "2.1.0",
  "type": "module",
  "description": "A user-friendly calendar app for viewing, selecting, and managing dates with data management capabilities.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.es.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": {
        "types": "./dist/cjs-types/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./dist/styles.css": "./dist/calendar-simple.css",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaganath-MSJ/CalendarSimple.git"
  },
  "homepage": "https://jaganath-msj.github.io/CalendarSimple/",
  "bugs": {
    "url": "https://github.com/Jaganath-MSJ/CalendarSimple/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && node scripts/cjs-types.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "tsc --noEmit && tsc --noEmit -p e2e && eslint src",
    "lint:fix": "tsc --noEmit && tsc --noEmit -p e2e && eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "size": "size-limit",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "calendar",
    "simple",
    "calendar-simple"
  ],
  "author": "jaganath-m-s",
  "license": "MIT",
  "dependencies": {
    "classnames": "^2.5.1",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "ajv": "^8.18.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "semantic-release": "^26.0.1",
    "size-limit": "^14.3.0",
    "storybook": "^10.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "overrides": {
    "eslint": "$eslint"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
